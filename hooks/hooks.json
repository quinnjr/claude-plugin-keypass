{
  "description": "Blocks writing plaintext API keys/JWTs into files — store them with keypass instead",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/block-secrets.sh\""
          }
        ]
      }
    ]
  }
}
